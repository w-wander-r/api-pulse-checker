# ============================================================
# ENVIRONMENT VARIABLES TEMPLATE (safe to commit - no secrets)
# ============================================================
# Copy to .env.local (git-ignored) and adjust if needed:
#   cp .env.example .env.local
#
# ------------------------------------------------------------
# DEVELOPMENT (default): local PostgreSQL in Docker
# `npm run dev` starts/keeps the container for you (see scripts/dev.mjs).
# user: wander, password: wander, database: wander
# ------------------------------------------------------------
DATABASE_URL=postgresql://wander:wander@localhost:5432/wander

# ------------------------------------------------------------
# PRODUCTION (Neon, managed PostgreSQL) - a SEPARATE database.
# Do NOT put the production URL in .env.local: local dev keeps using the
# Docker container above, and only the deployed app talks to Neon.
#
# 1. Neon console -> your project -> Connect -> copy the POOLED
#    connection string (it looks like):
#      postgresql://<user>:<pass>@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# 2. Create the schema on Neon once (prints the connected database name):
#      DATABASE_URL="<pooled url>" npm run db:migrate:prod
# 3. Set DATABASE_URL to the same value on the hosting platform
#    (e.g. Vercel: Project Settings -> Environment Variables).
# ------------------------------------------------------------
